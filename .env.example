# Salin ke .env.local lalu isi dari Supabase Dashboard → Project Settings → API.
# HANYA publishable/anon key. Jangan pernah menaruh service_role / secret key di sini.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Opsional: email kontak yang tampil di footer landing page.
VITE_CONTACT_EMAIL=

# Opsional: isi QR di stiker QRIS merchant (bukan rahasia). Default: QRIS Starlight di src/lib/config.ts.
VITE_QRIS_PAYLOAD=
# Opsional: WhatsApp admin (format 628…) untuk tombol "Kirim bukti via WhatsApp".
VITE_PAYMENT_WHATSAPP=
